{
  "name": "product-verification-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:integration:live": "vitest run tests/integration/live.test.js",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cloudinary": "^2.7.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^21.0.0",
    "helmet": "^8.0.0",
    "joi": "^18.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.3",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
}
